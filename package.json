{
  "name": "claude-code-tip-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": ".claude/hooks/check-all.sh --force",
    "dev": "next dev -p 5173",
    "dupes": "jscpd src --ignore \"**/*.spec.*\" --threshold 0 --reporters console",
    "format:check": "prettier --check .",
    "format:file": "prettier --write",
    "format": "prettier --write .",
    "knip": "knip --no-progress --reporter compact",
    "lint:file": "eslint --max-warnings 0",
    "lint": "eslint --max-warnings 0",
    "start": "next start -p 5173",
    "test:run": "vitest run",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "verify": "npm run -s check && npm run -s test:e2e",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "next": "^16.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.3.0",
    "jscpd": "^5.4.2",
    "jsdom": "^29.0.2",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.4"
  }
}
